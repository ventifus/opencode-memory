{
  "name": "opencode-memory",
  "version": "0.1.0",
  "description": "OpenCode plugin: passively captures conversation transcripts and compaction summaries into MemPalace, verbatim, without the agent having to remember to checkpoint manually. Does nothing else — no wake-up, no context injection; recall and journaling are the agent's own job (see the bundled mempalace-memory skill).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js -c jest.config.cjs",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "mempalace",
    "memory",
    "llm"
  ],
  "license": "MIT",
  "dependencies": {},
  "peerDependencies": {
    "@opencode/plugin": "*"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.0.29",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.19",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "jest": "^29.7.0",
    "prettier": "^3.5.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  }
}
